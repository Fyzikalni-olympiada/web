# Cache (Cloudflare Pages). Edge TTL řídí s-maxage — vyžaduje Cache Rule
# „Eligible for cache" + „Respect origin" v dashboardu. Konkrétnější pravidla
# níže přepisují obecné /*.
/*
  Cache-Control: public, max-age=0, s-maxage=86400
/temp/images/*
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=604800
/*.jpeg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.gif
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.pdf
  Cache-Control: public, max-age=604800
/data/*.json
  Cache-Control: public, max-age=3600
